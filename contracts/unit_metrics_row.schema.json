{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unit_metrics_row.schema.json",
  "title": "LOB irreversibility source-date metric row",
  "x-status": "approved_minimal_provenance_v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "stage",
    "symbol",
    "source_date",
    "train_regime",
    "test_regime",
    "B",
    "K",
    "model",
    "feature_config",
    "seed",
    "score_contract",
    "n_paths",
    "realized_source_events",
    "elapsed_seconds",
    "nats_path",
    "nats_block",
    "nats_event",
    "nats_second",
    "run_unit_id"
  ],
  "properties": {
    "stage": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "minLength": 1},
    "source_date": {"type": "string", "format": "date"},
    "train_regime": {"type": "string", "minLength": 1},
    "test_regime": {"type": "string", "minLength": 1},
    "B": {"type": "integer", "minimum": 1},
    "K": {"type": "integer", "minimum": 1},
    "model": {"type": "string", "minLength": 1},
    "feature_config": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "score_contract": {"enum": ["uncapped", "bounded_log99"]},
    "n_paths": {"type": "integer", "minimum": 0},
    "realized_source_events": {"type": "integer", "minimum": 0},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "nats_path": {"type": "number"},
    "nats_block": {"type": "number"},
    "nats_event": {"type": "number"},
    "nats_second": {"type": "number"},
    "run_unit_id": {"type": "string", "minLength": 1}
  }
}
